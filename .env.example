# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Do not put secrets in NEXT_PUBLIC_ variables.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact. Phone numbers use country code digits, for example 9198XXXXXXXX.
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_E164=
NEXT_PUBLIC_WHATSAPP_E164=
NEXT_PUBLIC_CONTACT_EMAIL=vsecure.enterprises.lavasa@gmail.com
# Paste only the iframe src from Google Maps, not the full embed snippet.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://maps.google.com/maps?q=18.3977523,73.4996976&hl=en&z=16&output=embed

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay. The key id is public. The secret and webhook secret stay on the server.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email. After payment, the receipt goes to the guest and to this host inbox.
RESEND_API_KEY=
EMAIL_FROM=
HOST_BOOKING_EMAIL=vsecure.enterprises.lavasa@gmail.com

# Used later to expire unpaid holds from a scheduled job.
CRON_SECRET=

# Restaurant database. Use the Supabase pooler URL for DATABASE_URL and the direct
# URL for migrations. Locally both can be the same Postgres URL.
DATABASE_URL=
DIRECT_URL=

# At least 32 characters. Used to hash OTP codes, phone numbers on OTP rows, and IP addresses.
DATA_PEPPER=
# 32 bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# console prints a masked send in the server log and does not call Meta.
# meta uses the WhatsApp Cloud API. DEV_RETURN_OTP is ignored in production.
WHATSAPP_PROVIDER=console
DEV_RETURN_OTP=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_WELCOME_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Authentication templates need the copy-code button parameter. Set false for a body-only template.
WHATSAPP_OTP_BUTTON=true
# Set true only if the welcome template has one body variable for the guest name.
WHATSAPP_WELCOME_HAS_NAME=false

# Seed passwords must be 12+ characters and include upper, lower, a digit, and a symbol.
# Re-running the seed does not reset an existing password.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STAFF_ONE_NAME=
SEED_STAFF_ONE_EMAIL=
SEED_STAFF_TWO_NAME=
SEED_STAFF_TWO_EMAIL=
SEED_STAFF_PASSWORD=
SEED_GSTIN=
